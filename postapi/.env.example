SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/postsapi
JWT_SECRET_BASE64=<base64-encoded-random-32-byte-key>
JWT_ISSUER=postapi
JWT_AUDIENCE=postapi-client
JWT_ACCESS_MINUTES=15
REFRESH_TOKEN_DAYS=7
APP_AES_KEY_BASE64=<different-base64-encoded-random-32-byte-key>
APP_AES_KEY_VERSION=v1
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Strict
FRONTEND_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173
DEV_ADMIN_USERNAME=<choose-a-local-admin-username>
DEV_ADMIN_PASSWORD=<unique-password-at-least-12-characters>